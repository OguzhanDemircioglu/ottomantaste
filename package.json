{
  "name": "ottomantaste",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/build-recipes-json.mjs && node scripts/build-search-index.mjs",
    "predev": "node scripts/build-recipes-json.mjs && node scripts/build-search-index.mjs",
    "dev": "next dev",
